rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function roomDocument(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomMember(roomId) {
      return signedIn()
        && roomDocument(roomId).data.members is map
        && roomDocument(roomId).data.members.keys().hasAny([request.auth.uid])
        && (!('status' in roomDocument(roomId).data)
          || roomDocument(roomId).data.status == 'active');
    }

    function validParticipantData(data) {
      return data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 40
        && data.lastActive is timestamp
        && data.lastActive == request.time
        && (!('joinedAt' in data) || data.joinedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validExpenseData(data, roomId, expenseId) {
      return data.keys().hasAll([
          'id', 'amount', 'payer', 'category', 'note', 'comment', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'amount', 'payer', 'category', 'note', 'comment', 'createdAt'
        ])
        && data.id is string
        && data.id == expenseId
        && data.id.size() >= 1
        && data.id.size() <= 120
        && data.amount is int
        && data.amount > 0
        && data.amount < 10000000
        && data.payer is string
        && data.payer.size() >= 1
        && data.payer.size() <= 128
        && roomDocument(roomId).data.members.keys().hasAny([data.payer])
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 20
        && data.note is string
        && data.note.size() <= 40
        && data.comment is string
        && data.comment.size() <= 80
        && data.createdAt is string
        && data.createdAt.size() >= 1
        && data.createdAt.size() <= 40;
    }

    function validRoomJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && before.members is map
        && after.members is map
        && !before.members.keys().hasAny([request.auth.uid])
        && after.members.keys().hasAny([request.auth.uid])
        && after.members[request.auth.uid] == true
        && after.members.size() == before.members.size() + 1
        && after.members.diff(before.members).affectedKeys().hasOnly([request.auth.uid])
        && before.capacity is int
        && before.capacity >= 1
        && before.capacity <= 50
        && after.capacity == before.capacity
        && after.members.size() <= before.capacity
        && (!('status' in before) || before.status == 'active')
        && after.joined == true
        && after.joinProof == before.inviteHash
        && after.updatedAt is timestamp
        && after.diff(before).affectedKeys().hasOnly([
          'members', 'joined', 'joinProof', 'updatedAt'
        ]);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /adminTrips/{tripId} {
      allow read, write: if isAdmin();
    }

    match /publishedTrips/{tripId} {
      allow read, write: if isAdmin();
    }

    match /accessGrants/{grantId} {
      allow get: if isAdmin() || (signedIn() && resource.data.status == 'active');
      allow list, create, update, delete: if isAdmin();
    }

    match /adminDistributions/{distributionId} {
      allow read, write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow get: if isAdmin()
        || (signedIn()
          && resource.data.members is map
          && resource.data.members.keys().hasAny([request.auth.uid])
          && (!('status' in resource.data) || resource.data.status == 'active'));
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || validRoomJoin();
      allow delete: if isAdmin();

      match /expenses/{expenseId} {
        allow read, delete: if isAdmin() || isRoomMember(roomId);
        allow create, update: if isAdmin()
          || (isRoomMember(roomId)
            && validExpenseData(request.resource.data, roomId, expenseId));
      }

      match /participants/{uid} {
        allow read: if isAdmin() || isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.auth.uid == uid
          && validParticipantData(request.resource.data)
          && request.resource.data.keys().hasAll(['nickname', 'lastActive', 'joinedAt'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.keys().hasOnly([
            'nickname', 'lastActive', 'joinedAt', 'updatedAt'
          ]);
        allow update: if isRoomMember(roomId)
          && request.auth.uid == uid
          && validParticipantData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nickname', 'lastActive', 'updatedAt'
          ]);
        allow delete: if isAdmin() || (isRoomMember(roomId) && request.auth.uid == uid);
      }
    }

  }
}
