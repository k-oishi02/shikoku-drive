rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function roomDocument(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomMember(roomId) {
      return signedIn()
        && roomDocument(roomId).data.members is map
        && roomDocument(roomId).data.members.keys().hasAny([request.auth.uid])
        && (!('status' in roomDocument(roomId).data)
          || roomDocument(roomId).data.status == 'active');
    }

    function validRoomJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && before.members is map
        && after.members is map
        && !before.members.keys().hasAny([request.auth.uid])
        && after.members.keys().hasAny([request.auth.uid])
        && after.members.size() == before.members.size() + 1
        && after.members.diff(before.members).affectedKeys().hasOnly([request.auth.uid])
        && after.members.size() <= 2
        && (!('capacity' in before) || after.members.size() <= before.capacity)
        && (!('status' in before) || before.status == 'active')
        && after.joinProof == before.inviteHash
        && after.diff(before).affectedKeys().hasOnly([
          'members', 'joined', 'joinProof', 'updatedAt'
        ]);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /adminTrips/{tripId} {
      allow read, write: if isAdmin();
    }

    match /publishedTrips/{tripId} {
      allow read, write: if isAdmin();
    }

    match /accessGrants/{grantId} {
      allow get: if isAdmin() || (signedIn() && resource.data.status == 'active');
      allow list, create, update, delete: if isAdmin();
    }

    match /adminDistributions/{distributionId} {
      allow read, write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow get: if isAdmin()
        || (signedIn()
          && resource.data.members is map
          && resource.data.members.keys().hasAny([request.auth.uid])
          && (!('status' in resource.data) || resource.data.status == 'active'));
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || validRoomJoin();
      allow delete: if isAdmin();

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isAdmin() || isRoomMember(roomId);
      }

      match /participants/{uid} {
        allow read: if isAdmin() || isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['nickname', 'lastActive'])
          && request.resource.data.keys().hasOnly([
            'nickname', 'lastActive', 'joinedAt', 'updatedAt'
          ]);
        allow update: if isRoomMember(roomId)
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nickname', 'lastActive', 'joinedAt', 'updatedAt'
          ]);
        allow delete: if isAdmin() || (isRoomMember(roomId) && request.auth.uid == uid);
      }
    }

    // Temporary write compatibility for clients cached before room-scoped presence.
    // Peer reads are intentionally disabled to prevent participant data leaking
    // between different invite rooms of the same trip.
    match /trips/{tripId}/participants/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
